# Grok Build zsh completion (on fpath before zicompinit; no second compinit)
[[ -r $HOME/.grok/completions/zsh/_grok ]] && {
  zi ice as"completion" id-as"grok-completion" lucid
  zi snippet $HOME/.grok/completions/zsh/_grok
